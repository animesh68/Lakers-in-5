# ==============================================================================
# Lakers in 5 — Environment Variable Specification Example
# Copy this file to .env for local development.
# NEVER commit production credentials or secrets to version control.
# ==============================================================================

# --- Server & Runtime Configuration ---
PORT=8000
WEB_CONCURRENCY=1
LOG_FORMAT=json

# --- Neon / PostgreSQL Database Connection (Production) ---
# Direct connection string format:
# postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# --- PostgreSQL Fallback Connection Parameters (Local / Docker Compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lakers_in_5
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# --- Connection Pool Tuning (512MB RAM budget) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_TIMEOUT=30
