# PostgreSQL Database Connection Configuration
# Copy this file to .env or set these environment variables in your environment.
# Never commit real credentials to version control.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lakers_in_5
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Optional Database Engine Parameters
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_TIMEOUT=30
